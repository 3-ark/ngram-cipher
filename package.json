{
  "name": "ngram-cipher",
  "description": "Natural English N-Gram Cipher Encoder and Decoder in TypeScript",
  "license": "MIT",
  "private": false,
  "version": "1.0.0",
  "main": "./dist/ngram-cipher.cjs",
  "module": "./dist/ngram-cipher.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ngram-cipher.js",
      "require": "./dist/ngram-cipher.cjs"
    },
    "./llm": {
      "types": "./dist/index.llm.d.ts",
      "import": "./dist/ngram-cipher-llm.js",
      "require": "./dist/ngram-cipher-llm.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "coverage:preview": "vite coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
